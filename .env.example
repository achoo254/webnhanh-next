# Trang server env. Nothing here is required in dev (PGlite under .data/, sign-in off). Production values live in the
# iCloud env folder "ENV production/trang-next/" and on the server in /etc/trang/production.env — never in the repo.

# development | test | production
NODE_ENV=development
# Server port on 127.0.0.1 (dev 5296; production 4860 behind nginx).
PORT=5296
# Where people open the app; the sign-in callback is PUBLIC_URL/auth/callback (dev: the Vite server on 5297).
PUBLIC_URL=http://localhost:5297
# The account service (OIDC issuer) and the confidential web client registered there.
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=trang-web
# Secret of trang-web at the account service, 32+ characters. Empty: sign-in is off.
AUTH_CLIENT_SECRET=
# Postgres, database `trang`. Empty: embedded PGlite under .data/pglite.
DATABASE_URL=

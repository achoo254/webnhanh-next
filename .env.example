# Web Nhanh server env. Nothing here is required in dev (PGlite under .data/, sign-in off). Production values live in the
# iCloud env folder "ENV production/webnhanh-next/" and on the server in /etc/webnhanh/production.env — never in the repo.

# development | test | production
NODE_ENV=development
# Server port on 127.0.0.1 (dev 5296; production 4860 behind nginx).
PORT=5296
# Where people open the app; the sign-in callback is PUBLIC_URL/auth/callback (dev: the Vite server on 5297).
PUBLIC_URL=http://localhost:5297
# The account service (OIDC issuer) and the confidential web client registered there.
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=webnhanh-web
# Secret of webnhanh-web at the account service, 32+ characters. Empty: sign-in is off.
AUTH_CLIENT_SECRET=
# Postgres, database `webnhanh`. Empty: embedded PGlite under .data/pglite.
DATABASE_URL=
# Uploaded photos of the editor (server writes, worker reads). Empty: .data/uploads (dev).
UPLOADS_DIR=
# An ffmpeg that can write WebP (libwebp) and its ffprobe, for cleaning uploads. Empty: the ones on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Template sites per account, and size limit of one site in MB (photos while editing, and each release).
SITES_PER_ACCOUNT=5
SITE_MAX_MB=20

# Signs the order form of every published page (worker) and checks it (server); 32+ characters, the same value for
# both. Required in production; dev and tests use a fixed dev value.
FORM_SECRET=
# Web Push of new orders: generate once with `npx web-push generate-vapid-keys` (on the server, never in the repo).
# All three or none (push off).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The Chat app and the bot that sends new orders (Developer Console of the Chat app). All four or none (the
# "Nhận báo đơn qua Chat" button is hidden). The bot's webhook is PUBLIC_URL/hooks/chat with this secret.
CHAT_URL=
CHAT_BOT_USERNAME=
CHAT_BOT_TOKEN=
CHAT_BOT_WEBHOOK_SECRET=
# Headless Chrome for the share picture (og:image) of each page; worker (and the dev server's worker). Empty: pages
# are published without one.
CHROME_PATH=

# Worker only (production; in dev the server runs the worker itself and publishes to .data/sites).
# Published sites, served by nginx for *.hoandat.io.vn.
SITES_DIR=
# How often the worker looks for a job, in ms.
POLL_MS=1000

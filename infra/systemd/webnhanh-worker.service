# /etc/systemd/system/webnhanh-worker.service — publishes queued sites one at a time: renders the template, copies the
# photos, photographs the share picture with headless Chrome (CHROME_PATH), makes the release live through
# @webnhanh/publish. Also deletes expired sessions, name holds, link codes, old notification records and unused photos.
[Unit]
Description=Web Nhanh publish worker
After=network-online.target postgresql.service webnhanh-server.service
Wants=network-online.target postgresql.service

[Service]
User=webnhanh
Group=webnhanh
# DATABASE_URL, SITES_DIR, UPLOADS_DIR, PUBLIC_URL, FORM_SECRET, CHROME_PATH, FFMPEG_PATH, SITE_MAX_MB (the shared
# env file; docs/deployment-guide.md). Chrome and ffmpeg get a minimal environment of their own, never this file.
EnvironmentFile=/etc/webnhanh/production.env
WorkingDirectory=/var/www/webnhanh/app
ExecStart=/opt/node22/bin/node --enable-source-maps apps/worker/dist/main.mjs
Restart=on-failure
RestartSec=5
# A publish is a file copy plus one Chrome screenshot (a few seconds, one Chrome at a time): capped memory, low
# priority beside the other apps of the server.
MemoryMax=512M
CPUQuota=50%
Nice=10
# Stop: the worker finishes the publish in hand (seconds), then exits.
TimeoutStopSec=30
UMask=0027
# Loopback only: Postgres on 127.0.0.1 is all the worker talks to; Chrome resolves no name either (share-image.ts).
# Order notifications go out from webnhanh-server, not from here.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/webnhanh/sites /var/www/webnhanh/uploads

[Install]
WantedBy=multi-user.target

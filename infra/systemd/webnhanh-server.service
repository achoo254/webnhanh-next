# /etc/systemd/system/webnhanh-server.service — the Web Nhanh API (sign-in, sessions, site editing, photo uploads).
[Unit]
Description=Web Nhanh API server
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=webnhanh
Group=webnhanh
# NODE_ENV=production, PORT=4860, PUBLIC_URL, DATABASE_URL, AUTH_*, UPLOADS_DIR, FFMPEG_PATH, FFPROBE_PATH: never in
# the repo (docs/deployment-guide.md).
EnvironmentFile=/etc/webnhanh/production.env
WorkingDirectory=/var/www/webnhanh/app
ExecStart=/opt/node22/bin/node --enable-source-maps apps/server/dist/server.mjs
Restart=on-failure
RestartSec=3
# ffmpeg cleaning an upload runs inside this limit too (one photo at a time, at most 24 MP).
MemoryMax=512M
CPUQuota=50%
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Uploaded photos, and zips of developer sites for webnhanh-builder; published sites are written by webnhanh-worker
# only.
ReadWritePaths=/var/www/webnhanh/uploads /var/lib/webnhanh/builds/inbox

[Install]
WantedBy=multi-user.target
